# Docker-specific environment overrides.
# DATABASE_URL is set by docker-compose.yml directly (points to the 'db' service).
# Only override application-level secrets here.

# REQUIRED — must be a long, high-entropy string
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
PORT=3000
NODE_ENV=production
